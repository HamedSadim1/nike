{
  "extends": "next/core-web-vitals",
  "env": {
    "browser": true,
    "es2020": true
  },
  "root": true,
  "plugins": ["react-refresh"],
  "ignorePatterns": ["dist", ".eslintrc.cjs"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "react-refresh/only-export-components": [
      "warn",
      { "allowConstantExport": true }
    ],
    "react/prop-types": 0
  }
}
